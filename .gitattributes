# Normalise line endings: LF in the repo, so Windows and macOS diffs stay clean.
* text=auto eol=lf

*.sln     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.hdr  binary
*.exr  binary
*.pdf  binary

# --- Git LFS for assets ---------------------------------------------------------
# Uncomment ONLY after everyone has run `git lfs install` once
# (Git for Windows ships LFS; macOS: `brew install git-lfs && git lfs install`).
# assets/**/*.obj  filter=lfs diff=lfs merge=lfs -text
# assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
# assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
# assets/**/*.hdr  filter=lfs diff=lfs merge=lfs -text
